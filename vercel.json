{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/portfolio-snapshot-capture.js": {
      "maxDuration": 60
    },
    "api/portfolio-snapshot-publish.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/portfolio-snapshot-capture",
      "schedule": "0 21 * * 1-5"
    },
    {
      "path": "/api/portfolio-snapshot-publish",
      "schedule": "0 23 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
