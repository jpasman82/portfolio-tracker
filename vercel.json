{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/portfolio-snapshot-morning.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/portfolio-snapshot-morning",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/portfolio-snapshot-morning",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/portfolio-snapshot-morning",
      "schedule": "0 13 * * 1-5"
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
